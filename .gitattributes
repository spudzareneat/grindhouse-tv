# The esbuild `text` loader embeds these files verbatim into a JS string
# literal (see web/build.mjs). On a Windows checkout with core.autocrlf=true,
# CRLF line endings get escaped as literal `\r` in the generated bundle,
# bloating every future `npm run bundle` diff with thousands of no-op lines.
# Force LF regardless of local autocrlf config.
web/src/styles/*.css text eol=lf

# The generated bundle itself is also always written LF by Node's esbuild —
# force LF on checkout too, or the same CRLF/LF churn reappears one level up
# (the whole file's own line endings, not just embedded CSS content).
app/src/main/assets/cytube_mobile.js text eol=lf
