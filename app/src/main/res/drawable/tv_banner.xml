<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV home-screen banner (320x180). Deep crimson gradient with the app icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/grindhouse_dark"
                android:endColor="#FF2A0810"
                android:angle="45" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@mipmap/ic_launcher" />
</layer-list>
