<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Grindhouse" parent="Theme.AppCompat.NoActionBar" />

    <!-- Branded boot splash. Holds the deep-crimson screen until CyTube loads. -->
    <style name="Theme.Grindhouse.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/grindhouse_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Grindhouse</item>
    </style>
</resources>
