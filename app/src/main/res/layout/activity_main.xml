<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.grindhouse.cytube.NoImeWebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Phone/tablet Cast button. Hidden by default; MainActivity shows + wires it only on
         non-TV devices when Cast is available. The standard MediaRouteButton gives the system
         device-chooser dialog for free. Placement is a prototype first pass. -->
    <androidx.mediarouter.app.MediaRouteButton
        android:id="@+id/cast_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/cast_button_desc"
        android:visibility="gone" />

    <!-- Loading overlay. The container holds an opaque dark background so the
         WebView never shows through while the image pulses; only the ImageView
         alpha animates. The whole container fades out once the page is styled. -->
    <FrameLayout
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grindhouse_dark">

        <ImageView
            android:id="@+id/loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/loading_poster"
            android:contentDescription="Loading" />

        <!-- Small status line at the bottom: native sets the early phases (before JS
             is injected), then the page's JS takes over via CytubeNative.setLoadingStatus.
             Sizing/bottom margin are bumped for TV (overscan) in MainActivity. -->
        <TextView
            android:id="@+id/loading_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="18dp"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:alpha="0.5"
            android:shadowColor="#FF000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:contentDescription="Loading status" />

    </FrameLayout>

</FrameLayout>
